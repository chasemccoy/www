---
import BlogFeed from './BlogFeed.vue';
import Breadcrumbs from './Breadcrumbs.vue';
import BlogPost from './BlogPost.vue';
import BlogPostPreview from './BlogPostPreview.vue';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Post = CollectionEntry<'posts'>;

interface Props {
  // Breadcrumb back to /archive/; omitted, there's none.
  label?: string;
  title: string;
  // Self-link on the title; omitted, the title is plain text.
  href?: string;
  posts: Post[];
}

const { label, title, href, posts } = Astro.props;

const titledPosts = posts.filter(
  (post): post is Post & { data: Post['data'] & { title: string } } =>
    Boolean(post.data.title)
);
const untitledPosts = posts.filter(post => !post.data.title);
---
<BlogFeed class="PostArchive">
  <div class="prose PostArchive__intro">
    {label && <Breadcrumbs><a href="/archive/" class="unstyled muted">{label}</a></Breadcrumbs>}
    <h1>
      {href ? <a href={href} class="unstyled">{title}</a> : title}
    </h1>
  </div>

  <div class="PostArchive__titledPosts">
    {titledPosts.map(post => (
      <BlogPostPreview
        title={post.data.title}
        date={post.data.date}
        permalink={post.data.permalink}
      />
    ))}
  </div>

  <div class="PostArchive__notes">
    {untitledPosts.map(async post => {
      const { Content } = await render(post);
      return (
        <BlogPost date={post.data.date} permalink={post.data.permalink}>
          <Content />
        </BlogPost>
      );
    })}
  </div>
</BlogFeed>

<style>
  .PostArchive__intro {
    margin-bottom: 16px;
  }

  .PostArchive__intro h1 a {
    color: var(--color-text);
  }

  .PostArchive__titledPosts {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .PostArchive__notes {
    border-top: 1px solid var(--color-border);
    margin-top: 40px;
    padding-top: 40px;
    padding-block-end: 80px;
  }

  .PostArchive__notes:not(:has(*)) {
    display: none;
  }
</style>
