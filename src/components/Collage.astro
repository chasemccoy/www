---
// The header collage, rendered at build time from src/collage/ (the editor's export, pulled in
// with `pnpm collage:pull`). Images are made at the widths their spots need (see
// utils/collage.ts); those shown at every size load eagerly.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import metadata from "../data/metadata.json";
import doc from "../collage/collage.json";
import { BREAKPOINTS, gridFor, imageScale, renderCollage } from "../collage/collage.js";
import type { CollageImageSource } from "../collage/collage.js";
import { imageSizes, imageWidths } from "../utils/collage";
import "../collage/collage.css";

// A note line matching a key (lowercased) becomes that link, and a note of two or more links
// renders as a <nav>. Links are muted so they skip the river (see .Masthead in _Wrapper.scss).
const NEW_TAB = { target: "_blank", rel: "noopener" };
const LINKS: Record<string, Record<string, string>> = {
  "chsmc.org": { href: "/", class: "muted unstyled" },
  archive: { href: "/archive/" },
  email: { href: `mailto:${metadata.author.email}` },
  rss: { href: metadata.feed.path },
  library: { href: "https://books.chsmc.org", ...NEW_TAB },
  lab: { href: "https://lab.chsmc.org", ...NEW_TAB },
  portfolio: { href: "https://portfolio.chsmc.org", ...NEW_TAB },
};

const files = import.meta.glob<ImageMetadata>("../collage/images/*", {
  eager: true,
  import: "default",
});
const byName = new Map(Object.entries(files).map(([file, meta]) => [file.split("/").pop(), meta]));
const grid = gridFor(doc);

const pictures = doc.items.flatMap((item) => {
  if (!("image" in item) || !item.image) return [];
  const src = byName.get(item.image);
  if (!src) throw new Error(`The collage uses ${item.image}, but it isn't in src/collage/images/.`);
  return [{ item, src, scale: imageScale(item, grid, src) }];
});
const widest = pictures.reduce<(typeof pictures)[number] | undefined>(
  (a, b) => ((b.scale.lg ?? 0) > (a?.scale.lg ?? 0) ? b : a),
  undefined,
);

const sources = new Map(
  await Promise.all(
    pictures.map(async ({ item, src, scale }) => {
      const widths = imageWidths(scale, src.width);
      const largest = widths.at(-1) ?? Math.min(src.width, 64);
      const [avif, webp] = await Promise.all([
        getImage({ src, widths: widths.length ? widths : [largest], format: "avif" }),
        getImage({ src, width: largest, format: "webp" }),
      ]);
      const shownEverywhere = Object.keys(scale).length === BREAKPOINTS.length;
      const source: CollageImageSource = {
        src: webp.src,
        sources: [{ type: "image/avif", srcset: avif.srcSet.attribute }],
        sizes: imageSizes(scale),
        width: src.width,
        height: src.height,
        loading: shownEverywhere ? "eager" : "lazy",
        ...(item === widest?.item && { fetchpriority: "high" }),
      };
      return [item.id, source] as const;
    }),
  ),
);

const html = renderCollage(doc, {
  image: (item) => sources.get(item.id),
  link: (text) => {
    const link = LINKS[text.toLowerCase()];
    return link && { class: "muted", ...link };
  },
});
---

<Fragment set:html={html} />
