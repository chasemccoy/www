---
import BlogFeed from './BlogFeed.vue';
import BlogPost from './BlogPost.vue';
import { shouldTruncatePost } from '../utils';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---
<BlogFeed>
  {posts.map(async post => {
    // Truncated posts render in full too; BlogPost shows only their opening.
    const isTruncated = shouldTruncatePost(post);
    const { Content } = await render(post);
    return (
      <BlogPost
        title={post.data.title}
        date={post.data.date}
        permalink={post.data.permalink}
        isTruncated={isTruncated}
        inlineDate
        isDraft={post.data.hidden}
      >
        <Content />
      </BlogPost>
    );
  })}
</BlogFeed>
