---
import HtmlLayout from "./HtmlLayout.astro";
import Collage from "../components/Collage.astro";
import type { LayoutProps } from "../types";

interface Props extends LayoutProps {
  date?: Date | string;
}

const { title, description, date } = Astro.props;
---

<HtmlLayout title={title} description={description} date={date}>
  <div class="Page">
    <header class="Masthead">
      {/* The collage's wordmark note is the visible title and the link home. */}
      <h1 class="visually-hidden">chsmc.org</h1>
      <Collage />
    </header>

    <div class="Wrapper">
      <main class="Wrapper__main">
        <slot />
      </main>
    </div>
  </div>
</HtmlLayout>
