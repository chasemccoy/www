---
import BaseLayout from './BaseLayout.astro';
import BlogPost from '../components/BlogPost.vue';
import Pagination from '../components/Pagination.vue';
import { getAdjacentPosts, getPermalinkFromPostId } from '../utils';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  date: Date | string;
  postId: string;
  isDraft?: boolean;
}

const { title, date, postId, isDraft } = Astro.props;

const allPosts = await getCollection('posts');
const { previous: previousPost, next: nextPost } = getAdjacentPosts(allPosts, postId);

const permalink = getPermalinkFromPostId(postId);
---
<BaseLayout
  title={title}
  date={date}
>
  <BlogPost title={title} date={date} permalink={permalink} isDraft={isDraft}>
    <slot />
  </BlogPost>

  <Pagination
    previousHref={previousPost?.permalink}
    previousLabel="Previous"
    previousTitle={previousPost?.title}
    nextHref={nextPost?.permalink}
    nextLabel="Next"
    nextTitle={nextPost?.title}
  />
</BaseLayout>
