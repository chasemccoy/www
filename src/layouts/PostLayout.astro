---
import BaseLayout from './BaseLayout.astro';
import BlogPost from '../components/BlogPost.vue';
import Pagination from '../components/Pagination.vue';
import { getAdjacentPosts } from '../utils';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, permalink, hidden } = post.data;

const allPosts = await getCollection('posts');
const { previous: previousPost, next: nextPost } = getAdjacentPosts(allPosts, post.id);
---
<BaseLayout
  title={title}
  date={date}
>
  <BlogPost title={title} date={date} permalink={permalink} isDraft={hidden}>
    <slot />
  </BlogPost>

  <Pagination
    previousHref={previousPost?.permalink}
    previousLabel="Previous"
    previousTitle={previousPost?.title}
    nextHref={nextPost?.permalink}
    nextLabel="Next"
    nextTitle={nextPost?.title}
  />
</BaseLayout>
