---
import '../styles/styles.scss';
import 'lite-youtube-embed/src/lite-yt-embed.css';
import metadata from '../data/metadata.json';
import { getPageTitle } from '../utils';
import { riverInlineStyle } from '../utils/river';

interface Props {
  title?: string;
  description?: string;
  date?: Date | string;
}

const { title, description, date } = Astro.props;
const pageUrl = Astro.url.pathname;

const pageTitle = getPageTitle(metadata.title, { title, date, pageUrl });
const desc = description || metadata.description;
const canonicalUrl = `${metadata.url}${pageUrl}`;
---
<!DOCTYPE html>
<html lang="en" style={riverInlineStyle(pageUrl)}>
<!--
  Take no thought of the harvest,
  but only of proper sowing.

  T. S. Eliot
-->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap');

      @font-face {
        font-family: 'Untitled Sans';
        src: url("/fonts/untitled-sans/UntitledSansWeb-Regular.woff2") format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Untitled Sans';
        src: url("/fonts/untitled-sans/UntitledSansWeb-RegularItalic.woff2") format('woff2');
        font-weight: normal;
        font-style: italic;
        font-display: swap;
      }

      @font-face {
        font-family: 'Untitled Sans';
        src: url("/fonts/untitled-sans/UntitledSansWeb-Bold.woff2") format('woff2');
        font-weight: bold;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Untitled Sans';
        src: url("/fonts/untitled-sans/UntitledSansWeb-BoldItalic.woff2") format('woff2');
        font-weight: bold;
        font-style: italic;
        font-display: swap;
      }

      @font-face {
        font-family: 'Sentinel';
        src: url("/fonts/sentinel/Sentinel-Book.woff2") format('woff2');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Sentinel';
        src: url("/fonts/sentinel/Sentinel-Bold.woff2") format('woff2');
        font-weight: bold;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" href={metadata.feed.path} type="application/rss+xml" title={metadata.title} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- Browser chrome tint: --color-body-background in each scheme. -->
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0911" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content="Chase McCoy" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta name="twitter:creator" content="@chase_mccoy" />
    <meta name="twitter:title" content={pageTitle} />
    <meta property="fediverse:creator" content="@chsmc@mastodon.social" />

    <script>import 'lite-youtube-embed/src/lite-yt-embed.js';</script>
    <script>
      import { riverColorAt, riverCycle, riverStops } from '../utils/river';

      // Must match the stops the build rendered: both derive them from the path.
      const stops = riverStops(location.pathname);
      let cycle = 1;

      // Mobile browsers fire resize constantly as the URL bar collapses, so
      // only re-anchor when height or width actually changed.
      let anchoredFor = '';

      function measure(el: HTMLElement) {
        const rect = el.getBoundingClientRect();
        return { el, y: rect.top + window.scrollY, height: rect.height };
      }

      function pin({ el, y, height }: ReturnType<typeof measure>) {
        el.style.setProperty('--river-pos', `0 ${-Math.round(y)}px`);
        if (el instanceof HTMLAnchorElement) {
          const center = y + height / 2;
          el.style.setProperty('--river-color', riverColorAt(stops, (center % cycle) / cycle));
        }
      }

      function anchorGradientText() {
        const height = document.documentElement.scrollHeight;
        const signature = `${height}x${window.innerWidth}`;
        if (signature === anchoredFor) return;
        anchoredFor = signature;
        cycle = riverCycle(height, stops);
        document.documentElement.style.setProperty('--river-size', `100% ${cycle}px`);
        // Read by the vignette in _river.scss.
        document.documentElement.style.setProperty('--river-doc', `${height}px`);

        // Must cover every element whose styles (or pseudo-elements)
        // @include river-text or river-fill; one-off elements opt in with
        // data-river-pin. Measure all, then write all, so the loop forces one
        // reflow.
        const pinned = document.querySelectorAll<HTMLElement>(
          'a, :not(pre) > code, hr.break, ul > li, .prose > p:last-of-type, .Callout, [data-river-pin]'
        );
        [...pinned].map(measure).forEach(pin);
        tintFavicon(true);
      }

      // The favicon is a river dot in the color at the middle of the screen.
      // A favicon can't read the page's CSS variables, so the color is
      // resolved to hex first, and the position is stepped so swaps stay
      // infrequent. Without JS, favicon.svg shows the river's first stop.
      const FAVICON_STEPS = 48;
      const favicon = document.querySelector<HTMLLinkElement>('link[rel="icon"][type="image/svg+xml"]');
      const probe = document.createElement('span');
      probe.hidden = true;
      document.body.append(probe);
      const paint = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
      let faviconStep = -1;

      function tintFavicon(force = false) {
        if (!favicon || !paint) return;
        const y = window.scrollY + window.innerHeight / 2;
        const step = Math.round(((y % cycle) / cycle) * FAVICON_STEPS) % FAVICON_STEPS;
        if (step === faviconStep && !force) return;
        faviconStep = step;
        probe.style.color = riverColorAt(stops, step / FAVICON_STEPS);
        paint.fillStyle = getComputedStyle(probe).color;
        paint.fillRect(0, 0, 1, 1);
        const rgb = paint.getImageData(0, 0, 1, 1).data.subarray(0, 3);
        const hex = `#${Array.from(rgb, (c) => c.toString(16).padStart(2, '0')).join('')}`;
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="${hex}"/></svg>`;
        favicon.href = `data:image/svg+xml,${encodeURIComponent(svg)}`;
      }

      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => tintFavicon(true));

      // The site-info box is sticky, so its links and tape move through the
      // river.
      const stickyPinned = document.querySelectorAll<HTMLElement>(
        '.Wrapper__header :is(a, [data-river-pin])'
      );
      let following = false;
      function followSticky() {
        following = false;
        stickyPinned.forEach((el) => pin(measure(el)));
        tintFavicon();
      }
      window.addEventListener(
        'scroll',
        () => {
          if (following) return;
          following = true;
          requestAnimationFrame(followSticky);
        },
        { passive: true }
      );

      // Again on load, once fonts and images have settled the layout.
      anchorGradientText();
      window.addEventListener('load', () => {
        anchorGradientText();
        // The scroll position may have been restored by now.
        tintFavicon();
      });

      let anchorTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(anchorTimer);
        anchorTimer = setTimeout(() => requestAnimationFrame(anchorGradientText), 120);
      });
    </script>
  </head>

  <body>
    <div id="texture"></div>
    
    <slot />

    <script async src="https://platform.twitter.com/widgets.js" is:inline></script>
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "488e6debfbc64509bd4b00dde784e24f"}' is:inline></script>
  </body>
</html>
