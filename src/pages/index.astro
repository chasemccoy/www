---
import BaseLayout from '../layouts/BaseLayout.astro';
import Feed from '../components/Feed.astro';
import Pagination from '../components/Pagination.vue';
import { getFeed, FEED_PAGE_SIZE } from '../utils';

const feed = await getFeed();

const posts = feed.slice(0, FEED_PAGE_SIZE);
const hasNextPage = feed.length > FEED_PAGE_SIZE;
---
<BaseLayout templateClass="home">
  <Feed posts={posts} />

  <Pagination previousHref={hasNextPage ? '/2/' : undefined} previousTitle="Older" style="margin-top: 6rem;" />
</BaseLayout>
