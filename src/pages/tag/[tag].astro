---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArchive from '../../components/PostArchive.astro';
import { capitalize, getPostsByTag, getTagSlug } from '../../utils';

export const getStaticPaths = async () => {
  const postsByTag = await getPostsByTag();
  return Object.entries(postsByTag).map(([tag, posts]) => ({
    params: { tag: getTagSlug(tag) },
    props: { tag, posts },
  }));
};

const { tag, posts } = Astro.props;
const title = capitalize(tag);
---
<BaseLayout title={title}>
  <PostArchive title={title} posts={posts} />
</BaseLayout>
