---
import BaseLayout from '../layouts/BaseLayout.astro';
import Feed from '../components/Feed.astro';
import FeedPagination from '../components/FeedPagination.vue';
import { getVisiblePosts, FEED_PAGE_SIZE } from '../utils';
import type { GetStaticPaths } from 'astro';

// A rest param so page 1 can live at `/`.
export const getStaticPaths = (async ({ paginate }) =>
  paginate(await getVisiblePosts(), { pageSize: FEED_PAGE_SIZE })) satisfies GetStaticPaths;

const { page } = Astro.props;
---
<BaseLayout>
  <Feed posts={page.data} />

  <div class="FeedFooter">
    <FeedPagination current={page.currentPage} total={page.lastPage} />
  </div>
</BaseLayout>

<style>
  .FeedFooter {
    margin-top: 6rem;
  }
</style>
