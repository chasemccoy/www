---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArchive from '../../components/PostArchive.astro';
import { getPostsByYear } from '../../utils';

export const getStaticPaths = async () => {
  const postsByYear = await getPostsByYear();
  return Object.entries(postsByYear).map(([year, posts]) => ({
    params: { year },
    props: { year, posts },
  }));
};

const { year, posts } = Astro.props;
---
<BaseLayout title={year}>
  <PostArchive label="Archives" title={year} href={`/${year}/`} posts={posts} />
</BaseLayout>
