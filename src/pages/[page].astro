---
import BaseLayout from '../layouts/BaseLayout.astro';
import Feed from '../components/Feed.astro';
import Pagination from '../components/Pagination.vue';
import { getFeed, FEED_PAGE_SIZE } from '../utils';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const feed = await getFeed();
  const totalPages = Math.ceil(feed.length / FEED_PAGE_SIZE);

  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({
      params: { page: String(i) },
      props: {
        posts: feed.slice((i - 1) * FEED_PAGE_SIZE, i * FEED_PAGE_SIZE),
        pageNumber: i,
        totalPages,
      },
    });
  }

  return paths;
}

interface Props {
  posts: CollectionEntry<'posts'>[];
  pageNumber: number;
  totalPages: number;
}

const { posts, pageNumber, totalPages } = Astro.props;

const hasNextPage = pageNumber < totalPages;
---
<BaseLayout>
  <Feed posts={posts} />

  <div class="FeedFooter">
    <Pagination
      previousHref={hasNextPage ? `/${pageNumber + 1}/` : undefined}
      previousTitle="Older"
      nextHref={pageNumber === 2 ? '/' : `/${pageNumber - 1}/`}
      nextTitle="Newer"
    />
  </div>
</BaseLayout>

<style>
  .FeedFooter {
    margin-top: 6rem;
  }
</style>
